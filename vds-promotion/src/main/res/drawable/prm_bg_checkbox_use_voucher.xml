<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked -->
    <item android:state_checked="true">

        <layer-list>

            <item android:state_checked="true">
                <shape android:shape="oval">
                    <solid android:color="@color/color_EE0033"/>
                </shape>
            </item>

            <item
                android:drawable="@drawable/prm_ic_tick_white"
                android:gravity="center"
                android:width="@dimen/_8sdp"
                android:height="@dimen/_5sdp" />
        </layer-list>

    </item>

    <!-- Unchecked -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/tokenDark40"/>
        </shape>
    </item>

</selector>