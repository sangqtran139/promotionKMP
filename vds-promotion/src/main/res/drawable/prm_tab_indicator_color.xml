<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- UNSELECTED TAB STATE -->
  <item android:state_selected="false" android:state_pressed="false">
    <layer-list>
      <!-- Bottom indicator color for the UNSELECTED tab state -->
      <item android:top="@dimen/view_size_45" android:left="@dimen/prm_detail_tab_underline_horizontal_inset" android:right="@dimen/prm_detail_tab_underline_horizontal_inset">
        <shape android:shape="line">
          <stroke android:color="@color/color_D3D3D3" android:width="@dimen/view_size_2"/>
        </shape>
      </item>
    </layer-list>
  </item>
</selector>