<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:orientation="horizontal">

        <com.ttcn.promotionsdk.ui.utils.view.PRMEditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:hint="@string/prm_please_input_endow"
            style="@style/fontPRMRegular16"
            android:includeFontPadding="false"
            android:lines="1"
            android:maxLines="1"
            android:background="@null"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_25sdp"
            android:singleLine="true"
            android:textColor="@color/color_222_cep"
            android:textCursorDrawable="@drawable/prm_text_cursor_edt"
            app:layout_constraintEnd_toStartOf="@+id/buttonSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.ttcn.promotionsdk.ui.utils.view.PRMImageView
            android:id="@+id/buttonClear"
            android:layout_width="@dimen/tokenSizing24"
            android:layout_height="@dimen/tokenSizing24"
            android:layout_marginEnd="@dimen/tokenSpacing04"
            android:adjustViewBounds="true"
            android:padding="@dimen/_2sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/prm_ic_close_16"
            app:layout_constraintEnd_toEndOf="@+id/searchInput"
            app:layout_constraintBottom_toBottomOf="@+id/searchInput"
            app:layout_constraintTop_toTopOf="@id/searchInput"
            app:prmIvEnableClickEffect="true" />

        <com.ttcn.promotionsdk.ui.utils.view.PRMTextView
            android:id="@+id/buttonSearch"
            style="@style/fontPRMMedium16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prm_check"
            app:layout_constraintBottom_toBottomOf="@id/searchInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/searchInput" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
