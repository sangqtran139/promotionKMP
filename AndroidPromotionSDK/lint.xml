<?xml version="1.0" encoding="utf-8"?>
<!--
  Rule cho tầng UI của SDK Android.

  Chọn theo **vi phạm đã đo trong repo**, không phải rule set mặc định copy về. Hiện trạng lúc bật
  (2026-09-10): 24 layout, 0 `android:text` hardcode, 0 màu `#xxxxxx`, 0 `textSize` dùng `dp`.
  Mục đích của file này là **giữ nguyên trạng sạch đó**, không phải để đi sửa một loạt.

  Vì sao library cần nghiêm hơn app: resource của Android library **merge thẳng vào app host**. Một
  `dimens` lỡ tay đặt là `padding_small` sẽ ghi đè resource cùng tên của host, hoặc làm AAPT báo
  duplicate. Đó là loại lỗi chỉ hiện ra ở phía host, sau khi đã tích hợp — muộn nhất có thể.
-->
<lint>
    <!-- ─── Rò rỉ sang app host — nhóm nghiêm trọng nhất với library ─────────────── -->

    <!--
      Đây là NỬA CÒN LẠI của `resourcePrefix = "prm"` trong build.gradle.kts: một mình
      `resourcePrefix` không chặn gì (đã kiểm — resource tên `totally_wrong_name` vẫn qua
      `assembleRelease`), nó chỉ là dữ liệu đầu vào cho rule này.

      Ghi chú cũ ở đây nói phải rename 54 chỗ viết `PRM` HOA trước mới bật được. Đã kiểm bằng thực
      nghiệm: **không cần** — check của AGP không phân biệt hoa/thường ở phần prefix, 31 style
      `PRMFont*` và 16 `declare-styleable` đi qua bình thường. Bật xong: 0 vi phạm.
    -->
    <issue id="ResourceName" severity="error" />

    <!-- Resource chết vẫn nằm trong AAR và vẫn merge vào host. -->
    <issue id="UnusedResources" severity="error" />

    <!-- ─── Giữ hệ theme token không bị bypass (hiện 0 vi phạm) ──────────────────── -->
    <issue id="HardcodedText" severity="error" />
    <issue id="SpUsage" severity="error" />

    <!-- ─── Vòng đời & rò rỉ bộ nhớ — SDK sống trong process của host ────────────── -->
    <issue id="StaticFieldLeak" severity="error" />
    <issue id="Recycle" severity="error" />

    <!-- ─── Accessibility ────────────────────────────────────────────────────────── -->
    <!--
      Đã xử lý hết ImageView trang trí bằng `importantForAccessibility="no"` (đúng cách — nó bảo
      TalkBack bỏ qua, khác `tools:ignore` chỉ làm im lint). Giữ `error` để không quay lại.

      GIỚI HẠN cần biết: rule này **không** soi được `com.ttcn.prm.ui.widget.PRMImageView` —
      lint bắt theo tên thẻ, mà phần lớn layout của SDK dùng custom view chứ không dùng `<ImageView>`
      trần. Nên gate xanh KHÔNG có nghĩa là đã phủ hết; 27 trong 31 ảnh của SDK là loại lint không
      thấy, và chúng được xử lý bằng tay. Thêm ảnh mới thì phải tự đặt thuộc tính, đừng chờ lint nhắc.
    -->
    <issue id="ContentDescription" severity="error" />
    <issue id="LabelFor" severity="warning" />

    <!-- ─── Tắt có chủ đích ─────────────────────────────────────────────────────── -->
    <!-- Ồn, và với SDK thì nền do host quyết (xem docs/features/OfferWidget.md §1.1). -->
    <issue id="Overdraw" severity="ignore" />
    <!--
      Trước đây `ignore` vì SDK chỉ có `values/` (vi). Nay đã có `values-en/` và
      `PromotionSessionConfig.language` **thật sự** đổi được chữ trên UI (xem `PRMLocale`), nên
      thiếu bản dịch là lỗi thật: màn hình lẫn hai ngôn ngữ, và chỉ QA mắt thường mới bắt được.
      `error` để mỗi chuỗi mới buộc phải có cả hai bản.
    -->
    <issue id="MissingTranslation" severity="error" />
</lint>
