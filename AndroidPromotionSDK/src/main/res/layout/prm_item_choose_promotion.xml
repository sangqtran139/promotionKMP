<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/prm_tokenDark05"
    android:paddingVertical="@dimen/prm_6sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlNotEnoughApplyVoucher"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prm_30sdp"
        android:layout_marginHorizontal="@dimen/prm_15sdp"
        android:layout_marginBottom="@dimen/prm_minus22sdp"
        android:background="@drawable/prm_not_enough_apply_voucher"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ctlTop"
        app:layout_constraintStart_toStartOf="parent">

        <com.ttcn.prm.ui.widget.PRMImageView
            android:id="@+id/imgWarning"
            android:importantForAccessibility="no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/prm_9sdp"
            android:layout_marginBottom="@dimen/prm_5sdp"
            android:src="@drawable/prm_ic_warning_yellow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.ttcn.prm.ui.widget.PRMTextView
            style="@style/PRMFontRegular12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/prm_3sdp"
            android:text="@string/prm_not_enough_apply_voucher"
            android:textColor="@color/prm_color_222_cep"
            app:layout_constraintBottom_toBottomOf="@id/imgWarning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgWarning"
            app:layout_constraintTop_toTopOf="@id/imgWarning" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/ctlTop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prm_82sdp"
        android:layout_marginHorizontal="@dimen/prm_15sdp"
        android:background="@color/prm_white"
        app:cardCornerRadius="@dimen/prm_12sdp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctlPartOne"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.24">

                <!--
                    Không bọc view mask hình tròn: Glide đã `CircleCrop` từng frame
                    (PRMImageExt.loadPromotionVoucherLogo) nên bitmap vào đây đã tròn sẵn.
                    `src` phải là bản TRÒN — placeholder/error của Glide cũng là bản này.
                -->
                <com.ttcn.prm.ui.widget.PRMImageView
                    android:id="@+id/imgVoucher"
                    android:importantForAccessibility="no"
                    android:layout_width="@dimen/prm_view_size_48"
                    android:layout_height="@dimen/prm_view_size_48"
                    android:src="@drawable/prm_bg_image_placeholder_circle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.ttcn.prm.ui.widget.PRMImageView
                android:id="@+id/imgCircleTop"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/prm_minus7sdp"
                android:src="@drawable/prm_bg_circle_gray_v2"
                app:layout_constraintEnd_toEndOf="@id/imgLine"
                app:layout_constraintStart_toStartOf="@id/imgLine"
                app:layout_constraintTop_toTopOf="parent" />

            <com.ttcn.prm.ui.widget.PRMImageView
                android:id="@+id/imgCircleBottom"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/prm_minus7sdp"
                android:src="@drawable/prm_bg_circle_gray_v2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/imgLine"
                app:layout_constraintStart_toStartOf="@id/imgLine" />

            <com.ttcn.prm.ui.widget.PRMImageView
                android:id="@+id/imgCircleNotEnoughApplyVoucher"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/prm_minus7sdp"
                android:src="@drawable/prm_bg_circle_gold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/imgLine"
                app:layout_constraintStart_toStartOf="@id/imgLine" />

            <com.ttcn.prm.ui.widget.PRMImageView
                android:id="@+id/imgLine"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginVertical="@dimen/prm_7sdp"
                android:background="@drawable/prm_bg_line_my_offer"
                app:layout_constraintStart_toEndOf="@+id/ctlPartOne" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/prm_11sdp"
                android:paddingTop="@dimen/prm_9sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ctlPartOne"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.76">

                <com.ttcn.prm.ui.widget.PRMTextView
                    android:id="@+id/txtVoucherName"
                    style="@style/PRMFontRegular12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/prm_2sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/prm_tokenDark60"
                    app:layout_constraintBottom_toBottomOf="@id/cbUseVoucher"
                    app:layout_constraintEnd_toStartOf="@id/cbUseVoucher"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cbUseVoucher"
                    tools:text="Viễn Thông" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/cbUseVoucher"
                    android:layout_width="@dimen/prm_15sdp"
                    android:layout_height="@dimen/prm_15sdp"
                    android:background="@drawable/prm_bg_checkbox_use_voucher"
                    android:button="@null"
                    android:contentDescription="@string/prm_a11y_select_voucher"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:checked="true" />

                <com.ttcn.prm.ui.widget.PRMTextView
                    android:id="@+id/tvContent"
                    style="@style/PRMFontMedium16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/prm_5sdp"
                    android:ellipsize="end"
                    android:lines="2"
                    android:maxLines="2"
                    android:textColor="@color/prm_color_222_cep"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/txtVoucherName"
                    app:layout_constraintTop_toBottomOf="@+id/txtVoucherName"
                    tools:text="Tặng 1 trà sen vàng cho hoá đơn từ 59khjshvjkfshaaaaaaaaaaaaaaaaaaaaaaaaaaaa" />

                <com.ttcn.prm.ui.widget.PRMTextView
                    android:id="@+id/tvEndDate"
                    style="@style/PRMFontRegular12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/prm_tokenDark60"
                    app:layout_constraintEnd_toStartOf="@id/lnDetail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvContent"
                    app:layout_goneMarginEnd="@dimen/prm_80sdp"
                    tools:text="HSD 18/10/2023" />

                <com.ttcn.prm.ui.widget.PRMTextView
                    android:id="@+id/txtExpired"
                    style="@style/PRMFontSfDisplayBold14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/prm_bg_item_offer_expired"
                    android:paddingHorizontal="@dimen/prm_5sdp"
                    android:paddingVertical="@dimen/prm_1sdp"
                    android:text="@string/prm_is_used"
                    app:layout_constraintBottom_toBottomOf="@id/tvEndDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvEndDate" />

                <LinearLayout
                    android:id="@+id/lnDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/tvEndDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvEndDate">

                    <com.ttcn.prm.ui.widget.PRMTextView
                        android:id="@+id/tvDetail"
                        style="@style/PRMFontBold14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/prm_detail"
                        android:textColor="@color/prm_color_EE0033" />

                    <com.ttcn.prm.ui.widget.PRMImageView
                        android:id="@+id/tvArrowDetail"
                        android:importantForAccessibility="no"
                        android:layout_width="@dimen/prm_12sdp"
                        android:layout_height="@dimen/prm_12sdp"
                        android:layout_gravity="bottom"
                        android:padding="@dimen/prm_2sdp"
                        android:src="@drawable/prm_ic_right_arrow_16_red" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
