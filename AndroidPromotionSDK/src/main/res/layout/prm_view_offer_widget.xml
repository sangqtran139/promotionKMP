<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.ttcn.prm.ui.widget.PRMTextView
        android:id="@+id/txtTitleOffer"
        style="@style/PRMFontSfDisplayBold18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prm_offer"
        android:textColor="@color/prm_color_222_cep"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerOffer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/prm_12sdp"
        app:shimmer_duration="@integer/prm_shimmer_duration"
        app:shimmer_repeat_delay="@integer/prm_shimmer_repeat_delay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitleOffer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/prm_18sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/prm_10sdp"
                android:background="@drawable/prm_background_shimmer" />

            <View
                android:layout_width="@dimen/prm_50sdp"
                android:layout_height="@dimen/prm_18sdp"
                android:background="@drawable/prm_background_shimmer" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.ttcn.prm.ui.widget.PRMTextView
        android:id="@+id/txtNumberOffer"
        style="@style/PRMFontSfDisplayMedium16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/prm_10sdp"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="@color/prm_color_222_cep"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/txtStatusOffer"
        app:layout_constraintEnd_toStartOf="@id/txtStatusOffer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtStatusOffer"
        tools:text="Bạn có 10 mã ưu đãi" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvOffer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/prm_8sdp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@id/txtStatusOffer"
        app:layout_constraintEnd_toStartOf="@+id/txtStatusOffer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtStatusOffer"
        tools:listitem="@layout/prm_item_list_promotion_apply" />

    <com.ttcn.prm.ui.widget.PRMTextView
        android:id="@+id/txtStatusOffer"
        style="@style/PRMFontSfDisplayMedium16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/prm_12sdp"
        android:textColor="@color/prm_color_EE0033"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitleOffer"
        tools:text="Sử dụng" />

</androidx.constraintlayout.widget.ConstraintLayout>
