<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/viewShimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_FBFBFB"
        android:orientation="vertical">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_search_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_base_color="@color/colorWhite"
            app:shimmer_colored="false"
            app:shimmer_duration="@integer/shimmer_duration"
            app:shimmer_highlight_color="@color/colorWhite"
            app:shimmer_repeat_delay="@integer/shimmer_repeat_delay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="@dimen/view_size_120"
                    android:layout_height="@dimen/view_size_16"
                    android:layout_marginStart="@dimen/view_size_20"
                    android:layout_marginTop="@dimen/view_size_20"
                    android:background="@drawable/prm_background_shimmer" />

                <include
                    layout="@layout/item_shimmer_my_promotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_size_8" />

                <include
                    layout="@layout/item_shimmer_my_promotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_shimmer_my_promotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_shimmer_my_promotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

    </LinearLayout>

</layout>
