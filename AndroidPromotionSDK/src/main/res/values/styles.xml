<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Theme ÉP LIGHT cho các màn SDK. Áp qua ContextThemeWrapper ở PRMBaseFragment.onGetLayoutInflater
      (+ ServiceSelectorBottomSheet) — KHÔNG đụng theme app host.

      Vì sao là theme Light ĐẦY ĐỦ (không chỉ forceDarkAllowed): host có thể dùng Theme.Material3.DayNight
      (như app demo). Ở dark mode, view SDK KHÔNG set màu tường minh sẽ lấy màu chữ/nền TỐI từ theme host
      → lệch UI. Inflate dưới theme Light này để màu ngầm định resolve ra sáng. Parent Material3 để widget
      Material (FAB/CardView/BottomSheet) không crash (material 1.13 có sẵn Theme.Material3.*).

      minSdk 24: attribute `android:forceDarkAllowed` (chặn OS force-dark, chỉ có API 29+) nằm ở
      res/values-v29/styles.xml. Bản default này bỏ qua nó nhưng vẫn là theme Light đầy đủ.
    -->
    <style name="PRMForceLight" parent="Theme.Material3.Light.NoActionBar" />

    <style name="prm_specific_rounded_corner">
        <item name="cornerSizeTopLeft">@dimen/prm_view_size_16</item>
        <item name="cornerSizeTopRight">@dimen/prm_view_size_16</item>
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
    </style>

    <style name="PRMFontRegular18">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_14sdp</item>
        <item name="lineHeight">@dimen/prm_18sdp</item>
    </style>

    <style name="PRMFontSfDisplayRegular16">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_12sdp</item>
        <item name="lineHeight">@dimen/prm_21sdp</item>
    </style>

    <style name="PRMFontSfDisplayBold22">
        <item name="fontFamily">@font/prm_sf_pro_display_bold</item>
        <item name="android:textSize">@dimen/prm_18sdp</item>
        <item name="lineHeight">@dimen/prm_21sdp</item>
    </style>

    <style name="PRMFontSfDisplayBold32">
        <item name="fontFamily">@font/prm_sf_pro_display_bold</item>
        <item name="android:textSize">@dimen/prm_26sdp</item>
        <item name="lineHeight">@dimen/prm_30sdp</item>
    </style>

    <style name="PRMFontSfDisplayBold18">
        <item name="fontFamily">@font/prm_sf_pro_display_bold</item>
        <item name="android:textSize">@dimen/prm_14sdp</item>
        <item name="lineHeight">@dimen/prm_18sdp</item>
    </style>

    <!--
      Cả file này nay dùng MỘT thế hệ theme: Material3. Trước đây trộn ba (AppCompat / Design /
      Material3) — hoạt động được vì `material` còn giữ alias cho tên thời Design Support Library,
      nhưng nó nghĩa là cách SDK render phụ thuộc vào **thế hệ nào resolve được attribute trước**,
      chỗ dễ vỡ khi nâng `material`.

      Theme này chỉ có một đường vào: `PRMBaseTheme.Dialog` ở `PRMBaseDialog.setStyle()`. Thứ duy
      nhất từng phụ thuộc thế hệ là màu tick `AppCompatCheckBox` trong `prm_dialog_confirm.xml`
      (không khai `buttonTint` nên lấy `colorAccent`) — đã ghim tint tường minh vào token của SDK,
      nên đổi parent không còn đụng vào hình.
    -->
    <style name="PRMBaseTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="prmRecyclerViewDividerSize">@dimen/prm_1sdp</item>
        <item name="prmRecyclerViewDividerTint">@color/prm_tokenDark10</item>
        <item name="prmRecyclerViewDividerAsSpace">false</item>
        <item name="prmRecyclerViewDividerDrawable">@color/prm_tokenWhite</item>
    </style>

    <style name="PRMBaseTheme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">stateUnchanged</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="PRMFontRegular10">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_8sdp</item>
        <item name="lineHeight">@dimen/prm_10sdp</item>
    </style>

    <style name="PRMFontSfDisplayRegular10">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_8sdp</item>
        <item name="lineHeight">@dimen/prm_10sdp</item>
    </style>

    <style name="PRMFontRegular12">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_10sdp</item>
        <item name="lineHeight">@dimen/prm_11sdp</item>
    </style>

    <style name="PRMFontRegular14">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_11sdp</item>
        <item name="lineHeight">@dimen/prm_14sdp</item>
    </style>

    <style name="PRMFontBold18">
        <item name="fontFamily">@font/prm_sf_pro_display_bold</item>
        <item name="android:textSize">@dimen/prm_14sdp</item>
        <item name="lineHeight">@dimen/prm_18sdp</item>
    </style>

    <style name="PRMFontDisPlayRegular14">
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/prm_10sdp</item>
        <item name="lineHeight">@dimen/prm_18sdp</item>
    </style>

    <style name="PRMFontBold14">
        <item name="fontFamily">@font/prm_sf_pro_display_bold</item>
        <item name="android:textSize">@dimen/prm_11sdp</item>
        <item name="lineHeight">@dimen/prm_14sdp</item>
    </style>

    <style name="PRMFontMedium16">
        <item name="fontFamily">@font/prm_sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/prm_13sdp</item>
        <item name="lineHeight">@dimen/prm_16sdp</item>
    </style>

    <style name="PRMFontMedium18">
        <item name="fontFamily">@font/prm_sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/prm_14sdp</item>
        <item name="lineHeight">@dimen/prm_18sdp</item>
    </style>

    <style name="PRMFontSfDisplayMedium18">
        <item name="fontFamily">@font/prm_sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/prm_14sdp</item>
        <item name="lineHeight">@dimen/prm_18sdp</item>
    </style>

    <!--
      `Widget.Material3.BottomSheet.Modal` thay cho `Widget.Design.BottomSheet.Modal` — tên cũ từ
      thời Design Support Library, `material` còn giữ alias nên vẫn resolve được, nhưng nó nghĩa là
      cách SDK render phụ thuộc vào thế hệ nào resolve được attribute trước. Style này chỉ đặt
      background trong suốt, phần parent đóng góp là shape/elevation vốn đã bị background che, nên
      đổi thế hệ ở đây không đổi hình.
    -->
    <style name="PRMCustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="PRMSlideButton">
        <!--        <item name="text">PRMSlideButton</item>-->
        <item name="prmTextSize">@dimen/prm_text_size_16</item>
        <item name="prmAreaMargin">@dimen/prm_view_size_8</item>
        <item name="prmInnerColor">?android:colorBackground</item>
        <item name="prmOuterColor">?colorAccent</item>
        <item name="prmSliderLocked">false</item>
    </style>

    <style name="PRMSlideButtonTextAppreance" parent="android:TextAppearance">
        <item name="android:textColor">@color/prm_tokenWhite</item>
        <item name="android:textSize">@dimen/prm_15sdp</item>
        <item name="android:fontFamily">@font/prm_sf_pro_display_medium</item>
    </style>

    <!--
      Theme ĐẦY ĐỦ (dùng làm `getTheme()` của `ServiceSelectorBottomSheet`), **không** phải
      `ThemeOverlay.Material3.BottomSheetDialog`: overlay chỉ resolve đúng khi theme nền đã là
      Material3, mà theme nền ở đây là theme app host — thứ SDK không kiểm soát. Kế thừa thẳng
      `Theme.Material3.Light.BottomSheetDialog` thì SDK tự mang đủ attribute, host ở thế hệ nào
      cũng không ảnh hưởng.
    -->
    <style name="PRMBaseBottomSheetDialog" parent="@style/Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/PRMCustomBottomSheetStyle</item>
        <item name="android:statusBarColor">@color/prm_tokenWhite</item>
        <item name="android:navigationBarColor">@color/prm_tokenWhite</item>
        <item name="android:windowSoftInputMode">adjustResize|adjustPan</item>
    </style>

    <style name="PRMFontBold32">
