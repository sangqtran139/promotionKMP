    <!--
      Parent đổi từ `TextAppearance.Design.Tab` (tên thời Design Support Library) sang thế hệ
      Material3. Không đổi hình: bốn attribute mà parent đóng góp — size, style, allCaps, font —
      đều bị style này ghi đè ngay bên dưới.
    -->
    <style name="PRMTabLayOutNew" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/prm_text_size_14</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/prm_sf_pro_display_regular</item>
    </style>



