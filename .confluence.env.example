# Cấu hình đẩy tài liệu lên Confluence — dùng bởi scripts/confluence_publish.py
# Copy file này thành `.confluence.env` rồi điền. `.confluence.env` đã bị .gitignore chặn,
# KHÔNG commit token.

# Cloud: https://<công-ty>.atlassian.net   |   Server/DC: https://wiki.noibo.vn
CONFLUENCE_BASE_URL=

# Key của space đích (chữ in hoa trên URL, vd .../spaces/TTCN/...)
CONFLUENCE_SPACE=

# Cloud: email đăng nhập Atlassian. Server/DC dùng Personal Access Token thì để TRỐNG.
CONFLUENCE_USER=

# Cloud: API token — id.atlassian.com/manage-profile/security/api-tokens
# Server/DC: Personal Access Token — ảnh đại diện → Settings → Personal Access Tokens
CONFLUENCE_TOKEN=
