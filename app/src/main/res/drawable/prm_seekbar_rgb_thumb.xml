<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item
        android:bottom="0dp"
        android:left="@dimen/view_size_2"
        android:right="@dimen/view_size_2"
        android:top="@dimen/view_size_3">
        <shape android:shape="oval">
            <solid android:color="@color/prm_color_picker_thumb_shadow" />
            <size
                android:width="@dimen/prm_color_picker_thumb_size"
                android:height="@dimen/prm_color_picker_thumb_size" />
        </shape>
    </item>
    <!-- thumb face -->
    <item
        android:bottom="@dimen/view_size_2"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/prm_theme_primary" />
            <stroke
                android:width="@dimen/view_size_1"
                android:color="@color/prm_color_picker_thumb_stroke" />
            <size
                android:width="@dimen/prm_color_picker_thumb_size"
                android:height="@dimen/prm_color_picker_thumb_size" />
        </shape>
    </item>
</layer-list>
