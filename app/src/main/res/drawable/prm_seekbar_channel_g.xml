<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/prm_color_picker_seek_track_radius" />
            <solid android:color="@color/prm_color_picker_track_bg" />
            <size android:height="@dimen/prm_color_picker_seek_track_height" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/prm_color_picker_seek_track_radius" />
                <solid android:color="@color/prm_channel_g_progress" />
                <size android:height="@dimen/prm_color_picker_seek_track_height" />
            </shape>
        </clip>
    </item>
</layer-list>
