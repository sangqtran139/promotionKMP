<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#fdfdfd"
        android:paddingHorizontal="@dimen/demo_view_size_24"
        android:paddingVertical="@dimen/demo_view_size_24">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_120sdp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/app_logo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCustomView"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/demo_view_size_24"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/app_launcher_btn_min_height"
            android:paddingVertical="@dimen/demo_view_size_14"
            android:text="@string/app_launcher_btn_custom_theme"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/demo_colorPrimary"
            app:cornerRadius="@dimen/app_launcher_btn_corner_radius"
            app:elevation="@dimen/demo_view_size_2"
            app:rippleColor="@color/app_launcher_btn_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenPaymentIntegrate"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/demo_view_size_16"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/app_launcher_btn_min_height"
            android:paddingVertical="@dimen/demo_view_size_14"
            android:text="@string/app_launcher_btn_payment_integrate"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/demo_colorPrimary"
            app:cornerRadius="@dimen/app_launcher_btn_corner_radius"
            app:elevation="@dimen/demo_view_size_2"
            app:rippleColor="@color/app_launcher_btn_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMyPromotion"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/demo_view_size_16"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/app_launcher_btn_min_height"
            android:paddingVertical="@dimen/demo_view_size_14"
            android:text="@string/app_launcher_btn_my_promotion"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/demo_colorPrimary"
            app:cornerRadius="@dimen/app_launcher_btn_corner_radius"
            app:elevation="@dimen/demo_view_size_2"
            app:rippleColor="@color/app_launcher_btn_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenPromotionDetail"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/demo_view_size_16"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/app_launcher_btn_min_height"
            android:paddingVertical="@dimen/demo_view_size_14"
            android:text="@string/app_launcher_btn_promotion_detail"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/demo_colorPrimary"
            app:cornerRadius="@dimen/app_launcher_btn_corner_radius"
            app:elevation="@dimen/demo_view_size_2"
            app:rippleColor="@color/app_launcher_btn_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeadlessDemo"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/demo_view_size_16"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/app_launcher_btn_min_height"
            android:paddingVertical="@dimen/demo_view_size_14"
            android:text="@string/app_launcher_btn_headless_demo"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/demo_colorPrimary"
            app:cornerRadius="@dimen/app_launcher_btn_corner_radius"
            app:elevation="@dimen/demo_view_size_2"
            app:rippleColor="@color/app_launcher_btn_ripple" />
    </LinearLayout>
</layout>
