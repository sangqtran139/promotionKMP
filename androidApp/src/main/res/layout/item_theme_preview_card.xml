<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/prm_bg_theme_card"
        android:orientation="vertical"
        android:padding="@dimen/prm_theme_card_padding">

        <LinearLayout
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/prm_view_size_20"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgGroupIcon"
                android:layout_width="@dimen/prm_view_size_24"
                android:layout_height="@dimen/prm_view_size_24"
                android:contentDescription="@null"
                tools:src="@drawable/prm_ic_theme_button" />

            <TextView
                android:id="@+id/txtCardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/prm_view_size_12"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/prm_theme_title_text"
                android:textSize="@dimen/prm_text_size_20"
                android:textStyle="bold"
                tools:text="Button (4)" />

            <ImageView
                android:id="@+id/imgChevron"
                android:layout_width="@dimen/prm_view_size_24"
                android:layout_height="@dimen/prm_view_size_24"
                android:contentDescription="@null"
                android:src="@drawable/prm_ic_chevron_up" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/tokenContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/prm_view_size_16"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prm_theme_preview_btn_height"
                android:layout_marginTop="@dimen/prm_view_size_36"
                android:background="@drawable/prm_bg_theme_preview_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/prm_theme_preview"
                android:textAllCaps="false"
                android:textColor="@color/prm_theme_primary"
                android:textSize="@dimen/prm_text_size_20" />
        </LinearLayout>
    </LinearLayout>
</layout>
