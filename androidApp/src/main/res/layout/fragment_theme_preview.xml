<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prm_bg_theme_screen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/demo_dimen_56dp"
        android:paddingTop="@dimen/demo_view_size_8"
        android:paddingBottom="@dimen/demo_view_size_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/demo_view_size_48"
            android:layout_height="@dimen/demo_view_size_48"
            android:layout_marginStart="@dimen/prm_theme_header_side_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="@dimen/demo_view_size_10"
            android:scaleType="centerInside"
            android:src="@drawable/prm_ic_back_theme"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/prm_theme_custom_title"
            android:textColor="@color/prm_theme_primary"
            android:textSize="@dimen/prm_theme_title_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/footerDividerTop"
        android:layout_width="0dp"
        android:layout_height="@dimen/demo_view_size_1"
        android:background="@color/prm_theme_divider"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/prm_theme_footer_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/demo_view_size_18"
        android:paddingTop="@dimen/demo_view_size_20"
        android:paddingEnd="@dimen/demo_view_size_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/demo_view_size_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLoadJsonFile"
                android:layout_width="0dp"
                android:layout_height="@dimen/prm_theme_footer_btn_height"
                android:layout_marginEnd="@dimen/demo_view_size_8"
                android:layout_weight="1"
                android:background="@drawable/prm_bg_theme_reset_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/prm_theme_load_json_file"
                android:textAllCaps="false"
                android:textColor="@color/prm_theme_reset_text"
                android:textSize="@dimen/demo_text_size_16" />

            <TextView
                android:id="@+id/btnApplyObject"
                android:layout_width="0dp"
                android:layout_height="@dimen/prm_theme_footer_btn_height"
                android:layout_weight="1"
                android:background="@drawable/prm_bg_theme_reset_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/prm_theme_apply_object"
                android:textAllCaps="false"
                android:textColor="@color/prm_theme_reset_text"
                android:textSize="@dimen/demo_text_size_16" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="@dimen/prm_theme_footer_btn_height"
                android:layout_marginEnd="@dimen/demo_view_size_8"
                android:layout_weight="1"
                android:background="@drawable/prm_bg_theme_reset_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/prm_theme_reset"
                android:textAllCaps="false"
                android:textColor="@color/prm_theme_reset_text"
                android:textSize="@dimen/demo_text_size_18" />

            <TextView
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="@dimen/prm_theme_footer_btn_height"
                android:layout_weight="1"
                android:background="@drawable/prm_bg_theme_apply_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/prm_theme_apply"
                android:textAllCaps="false"
                android:textColor="@color/demo_tokenWhite"
                android:textSize="@dimen/demo_text_size_18" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/footerDividerTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/prm_theme_scroll_bottom_padding">

            <TextView
                android:id="@+id/txtSubHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="600"
                android:layout_marginStart="@dimen/prm_theme_content_horizontal_margin"
                android:layout_marginTop="@dimen/demo_view_size_14"
                android:layout_marginEnd="@dimen/prm_theme_content_horizontal_margin"
                android:fontFamily="sans-serif"
                android:text="@string/prm_theme_config_subtitle"
                android:textColor="@color/prm_theme_title_text"
                android:textSize="@dimen/prm_theme_subheader_text_size" />

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/prm_theme_content_horizontal_margin"
                android:layout_marginTop="@dimen/demo_view_size_8"
                android:layout_marginEnd="@dimen/prm_theme_content_horizontal_margin"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
